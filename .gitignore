# Dependencies and build output — never committed
node_modules/
dist/
release/

# Generated by the build (regenerate with `npm run gen:all`)
src/pages/
src/partials/docs/
src/data/navigation.js
public/sitemap.xml
public/robots.txt

# Logs and caches
*.log
npm-debug.log*
.vite/
.cache/
.eslintcache
.sass-cache/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local secrets — API keys, tokens, environment overrides
.env
.env.local
.env.*.local
